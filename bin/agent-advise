#!/bin/sh
# Advisor：用更强的模型、干净的上下文，对一张卡给出判断。只读，不改代码。
# 触发靠机械信号，不靠模型自觉：agent-dispatch 退出码 3（修满 3 轮）、门禁连续两轮报出新问题、主脑定方向前。
# 给 Advisor 的材料：任务卡、每一轮的门禁结论、相对基线的改动概况、主脑的问题。
#   不给前几轮执行器的对话，避免把失败的思路一起带进去；需要细节它自己读代码。
# 用法：agent-advise <worktree> <question.md>
# 成功时 stdout 输出 Advisor 的回复。退出码：0 正常；1 Advisor 运行出错；2 用法或环境错误。
set -eu

if [ $# -ne 2 ]; then
    echo "用法: $0 <worktree> <question.md>" >&2
    exit 2
fi
worktree=$1
question=$2
root=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd -P)
[ -f "$question" ] || { echo "ADVISE ERROR: 文件不存在 $question" >&2; exit 2; }

branch=$(git -C "$worktree" symbolic-ref --short -q HEAD) || {
    echo "ADVISE ERROR: $worktree 不是 git 工作区或处于 detached HEAD" >&2
    exit 2
}
case $branch in
    card/*) id=${branch#card/} ;;
    *) echo "ADVISE ERROR: $worktree 当前分支 $branch 不是 card/<task-id>" >&2; exit 2 ;;
esac
repo=$(dirname "$(git -C "$worktree" rev-parse --path-format=absolute --git-common-dir)")
state=${AGENT_DISPATCH_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/agent-dispatch}
card_runs=$state/runs/$(basename "$repo")/$id
rounds=$(ls -d "$card_runs"/*-exec "$card_runs"/*-fix-* 2>/dev/null | sort || true)
if [ -z "$rounds" ]; then
    echo "ADVISE ERROR: card/$id 还没派过，没有可供判断的材料" >&2
    exit 2
fi
latest=$(printf '%s\n' "$rounds" | tail -1)
base=$(python3 -I -c 'import json,sys; print(json.load(open(sys.argv[1]))["base"])' "$latest/dispatch.json")

route=$(awk -F '\t' '$1 == "advisor" { print $3, $4; exit }' "$root/routing.tsv")
[ -n "$route" ] || { echo "ADVISE ERROR: routing.tsv 里没有 advisor 一行" >&2; exit 2; }
group=${route% *}
effort=${route#* }

prompt=$(mktemp)
trap 'rm -f "$prompt"' EXIT
{
    cat <<'EOF'
# 角色

你是 Advisor（顾问）。一张任务卡交给执行器做了几轮还没通过，主脑来请教你。
你只读不写：可以读代码、跑只读的命令（git log / git diff / 查看文件），不要修改任何文件，不要提交。
你没有前几轮的对话历史，这是故意的：请从头判断，不要被已有的做法带着走。

请给出明确结论，三选一，并说明理由：
- 继续：问题在哪、下一轮修复应该怎么做（具体到文件和做法）
- 换方案：原方案为什么走不通，新方案是什么，卡要怎么改
- 放弃：这张卡为什么不该做或不值得做

EOF
    echo "# 任务卡"
    echo
    cat "$latest/card.md"
    echo
    echo "# 各轮门禁结论"
    printf '%s\n' "$rounds" | while IFS= read -r r; do
        echo
        echo "## $(basename "$r")"
        echo '```'
        if [ -f "$r/gate.txt" ]; then tail -30 "$r/gate.txt"; else echo "（没有门禁输出）"; fi
        echo '```'
    done
    echo
    echo "# 相对 $base 的改动"
    echo '```'
    git -C "$worktree" log --oneline "$base..HEAD" | head -30
    git -C "$worktree" diff --stat "$base...HEAD" | tail -30
    echo '```'
    echo
    echo "# 主脑的问题"
    echo
    cat "$question"
} > "$prompt"

rc=0
run_dir=$("$root/bin/agent-run" --read-only "$worktree" "$prompt" "$group" "$effort" advise) || rc=$?
if [ $rc -eq 2 ] || [ -z "$run_dir" ]; then
    echo "ADVISE ERROR: agent-run 启动失败" >&2
    exit 2
fi
cp "$question" "$run_dir/question.md"
echo "ADVISE: 记录 $run_dir" >&2
cat "$run_dir/last.md"
exit $rc
